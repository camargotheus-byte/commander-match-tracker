{
  "name": "MTG Match Tracker — Retro Edition",
  "short_name": "MTG Tracker",
  "description": "The numbers of your legacy. Track Magic: The Gathering matches across 23 format profiles, decks, mana identity, rivals, and performance benchmarks.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#F1D27A",
